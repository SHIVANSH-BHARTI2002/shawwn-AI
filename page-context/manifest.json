{
  "manifest_version": 3,
  "name": "PageContext",
  "version": "1.0.0",
  "description": "Extract clean webpage content for AI agents and RAG systems.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "PageContext"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
