APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Force deterministic light-mode (no heavy models / external services).
# Leave false to use real models when the ML stack + services are available.
SHAWWN_LIGHT_MODE=false

# --- LLM ---
# Preferred provider: gemini | openai. Falls back to the offline extractive
# provider when no key is set.
LLM_PROVIDER=gemini

# Google Gemini (multimodal: reads images + PDFs, human-like answers).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Mistral AI (text; used as a fallback when Gemini is overloaded).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenAI (alternative provider).
OPENAI_API_KEY= 
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=


# Higher = more natural / human-like phrasing (0.0–1.0).
LLM_TEMPERATURE=0.4

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=shawwn_chunks

# --- PostgreSQL ---
# Local default uses SQLite; docker-compose overrides with Postgres.
POSTGRES_URL=sqlite+aiosqlite:///./shawwn.db
# Example Postgres: postgresql+asyncpg://shawwn:shawwn@postgres:5432/shawwn

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Models ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_DIM=1024

# --- Retrieval ---
TOP_K_DENSE=10
TOP_K_BM25=10
TOP_K_RERANK=5
DENSE_WEIGHT=0.7
BM25_WEIGHT=0.3
RERANK_SCORE_THRESHOLD=0.0

# --- Chunking ---
CHUNK_SIZE=700
CHUNK_OVERLAP=100
MAX_CONTEXT_CHARS=12000

# --- Security / CORS ---
CORS_ORIGINS=http://localhost:8000,chrome-extension://*
AUTH_ENABLED=false
API_TOKEN=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=30
RATE_LIMIT_DOCUMENTS=20
RATE_LIMIT_WINDOW_SECONDS=60
